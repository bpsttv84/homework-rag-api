# OpenRouter (required for LLM)
OPENROUTER_API_KEY=

# Qdrant — local: http://localhost:6333 ; Cloud: https://xxx.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Collections (defaults match app)
QDRANT_CHUNKS_COLLECTION=rag_chunks
QDRANT_CACHE_COLLECTION=rag_cache

# Redis — local: redis://localhost:6379/0 ; Upstash: rediss://default:...@...upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Cost DB — SQLite default
DATABASE_URL=sqlite+aiosqlite:///./data/costs.db

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Admin rebuild (POST /index/rebuild)
ADMIN_API_KEY=change-me-admin

LLM_CONCURRENCY=20
EMBEDDING_MODEL=all-MiniLM-L6-v2
